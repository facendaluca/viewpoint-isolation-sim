{
  "scenario": "eval_e2",
  "policy": { "mode": "heuristic", "curiosity": 0.30 },

  "steps": 200,
  "engine": "baseline",
  "top_k": 5,
  "rank_alpha": 0.30,

  "enable_viewpoint_drift": true,
  "drift_alpha": 0.02,

  "lock_in_threshold": 0.20,
  "persistence_window": 10,

  "enable_interest_updates": true,
  "interest_topic_alpha": 0.10,
  "interest_tag_alpha": 0.05,
  "interest_decay": 0.02,
  "interest_normalise": false,
  "interest_prune_below": 0.001,

  "seeds": [0, 1, 2, 3, 4],

  "n_agents": 3,
  "agents": [
    {
      "agent_id": "watcher",
      "phenotype": "watcher",
      "viewpoint_score": 0.40,
      "sentiment_threshold": -0.20,
      "interest_vector": {
        "politics": 0.25, "sports": 0.20, "health_wellness": 0.30, "comedy_memes": 0.75,
        "meme": 0.90, "news": 0.55, "football": 0.40, "sleep": 0.35, "viral": 0.60, "tech": 0.25
      }
    },
    {
      "agent_id": "sampler",
      "phenotype": "sampler",
      "viewpoint_score": 0.40,
      "sentiment_threshold": -0.20,
      "interest_vector": {
        "politics": 0.25, "sports": 0.20, "health_wellness": 0.30, "comedy_memes": 0.75,
        "meme": 0.90, "news": 0.55, "football": 0.40, "sleep": 0.35, "viral": 0.60, "tech": 0.25
      }
    },
    {
      "agent_id": "avoider",
      "phenotype": "avoider",
      "viewpoint_score": 0.40,
      "sentiment_threshold": -0.20,
      "interest_vector": {
        "politics": 0.25, "sports": 0.20, "health_wellness": 0.30, "comedy_memes": 0.75,
        "meme": 0.90, "news": 0.55, "football": 0.40, "sleep": 0.35, "viral": 0.60, "tech": 0.25
      }
    }
  ],

  "corpus": {
    "source": "generated",
    "n_videos": 1000,
    "seed": 260303,
    "generator": {
      "topic": {
        "weights": {
          "comedy_memes": 0.30,
          "health_wellness": 0.1667,
          "diy_life_hacks": 0.1667,
          "fashion_beauty": 0.1666,
          "politics": 0.10,
          "sports": 0.05,
          "international_news": 0.05
        }
      },
      "sentiment": {
        "weights": {
          "-1.0": 0.15,
          "0.0": 0.70,
          "1.0": 0.15
        }
      },
      "viewpoint": {
        "weights": {
          "0.0": 0.20,
          "0.5": 0.60,
          "1.0": 0.20
        }
      },
      "duration": {
        "dist": "lognormal",
        "params": { "mean": 3.5, "sigma": 0.6 },
        "min": 10,
        "max": 180
      },
      "tags": {
        "vocab": [
          "meme", "news", "viral", "cats", "football",
          "basketball", "gym", "meditation", "sleep", "diet",
          "politics", "debate", "satire", "podcast", "travel",
          "science", "tech", "gaming", "music", "fashion"
        ],
        "per_video": { "min": 0, "max": 5 }
      }
    }
  }
}