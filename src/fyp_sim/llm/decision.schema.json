{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": " LLM Decision Contract (v1)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "action",
        "confidence"
    ],
    "properties": {
        "action": {
            "type": "string",
            "enum": [
                "Avoid",
                "Sample",
                "Watch"
            ],
            "description": "Discrete action the agent chooses."
        },
        "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Model confidence in [0,1]."
        },
        "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Short explanation of why the decision was made."
        },
        "watch_time_s": {
            "type": "integer",
            "minimum": 0,
            "description": "Optional override/estimate of watch time in seconds."
        },
        "rewatch": {
            "type": "boolean",
            "description": "Whether the user wants to rewatch the video."
        },
        "share": {
            "type": "boolean",
            "description": "Whether the user wants to share the video."
        },
        "notes": {
            "type": "string",
            "description": "Optional notes (debugging / trace)."
        }
    }
}